{
  "name": "sideline",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Thuuz-style sports scores PWA with excitement ratings.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test test/*.test.mjs",
    "probe": "node scripts/probe-endpoints.mjs",
    "backfill": "node scripts/backfill.mjs",
    "brief": "node scripts/build-brief.mjs --force",
    "fixtures": "node scripts/make-fixtures.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "icons": "node scripts/build-icons.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@fontsource/space-grotesk": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "opentype.js": "^2.0.0"
  }
}
